# Option A: Claude (what the live demo and the README's eval numbers use)
ANTHROPIC_API_KEY=sk-ant-...

# Option B: run fully locally with Ollama (https://ollama.com), no API key.
# Uncomment these and `ollama pull` the model first.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434
